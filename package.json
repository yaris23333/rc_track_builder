{
  "name": "rc-track-builder",
  "private": true,
  "version": "0.2.0",
  "description": "RC Track Designer — monorepo（Web 编辑器 + 可复用核心包）",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @rctrack/web dev",
    "build": "pnpm --filter @rctrack/web build",
    "preview": "pnpm --filter @rctrack/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
